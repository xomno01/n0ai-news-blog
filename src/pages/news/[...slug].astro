---
import { getCollection, render } from 'astro:content';
import NewsLayout from '../../layouts/NewsLayout.astro';
export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.filter(p => !p.data.draft).map(post => ({ params: { slug: post.id }, props: { post }}));
}
const { post } = Astro.props;
const { Content } = await render(post);
const site = 'https://news.n0ai.cloud';
const url = new URL(`/news/${post.id}`, site).toString();
const newsLd = { "@type": "NewsArticle", "@id": `${url}#article`, "headline": post.data.title, "description": post.data.description, "image": { "@type": "ImageObject", "url": post.data.cover.src }, "datePublished": post.data.publishDate.toISOString(), "dateModified": (post.data.updateDate ?? post.data.publishDate).toISOString(), "author": { "@type": "Person", "name": post.data.author.name }, "publisher": { "@id": `${site}/#org` }, "articleSection": post.data.category };
const faqLd = post.data.faq?.length ? { "@type": "FAQPage", "mainEntity": post.data.faq.map(f => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer }})) } : null;
const breadcrumbLd = { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": site }, { "@type": "ListItem", "position": 2, "name": "News", "item": `${site}/news` }, { "@type": "ListItem", "position": 3, "name": post.data.title, "item": url }] };
const jsonLd = [newsLd, breadcrumbLd, ...(faqLd?[faqLd]:[])];
---
<NewsLayout title={post.data.title} description={post.data.description} canonical={url} image={post.data.cover.src} type="article" publishDate={post.data.publishDate} jsonLd={jsonLd}>
  <div class="bg-red-600 text-white"><div class="mx-auto max-w-[760px] px-4 sm:px-6 py-2 flex items-center gap-2 mono text-[11px]"><span class="px-2 py-1 bg-white text-red-600 font-[800]">{post.data.breaking ? 'BREAKING' : post.data.category.toUpperCase()}</span><span class="opacity-80">{post.data.publishDate.toLocaleDateString('vi-VN')}</span><span class="ml-auto hidden sm:inline opacity-70">{post.data.readingTime ?? 5}′ • {post.data.category}</span></div></div>
  <main class="mx-auto max-w-[760px] px-4 sm:px-6 py-6 bg-[#f8f5f0] text-black">
    <h1 class="font-[900] tracking-[-0.03em] leading-[0.95] text-[30px] sm:text-[40px]" style="font-family: 'Instrument Serif', serif;">{post.data.title}</h1>
    <p class="mt-3 text-[16px] leading-relaxed opacity-70 border-l-[3px] border-red-600 pl-4">{post.data.description}</p>
    <div class="mt-4 flex items-center gap-2 mono text-[11px] border-y border-black/10 py-3"><span class="size-6 rounded-full bg-black text-white grid place-items-center text-[10px]">{post.data.author.name[0]}</span><span class="font-[700]">{post.data.author.name}</span><span class="opacity-50">— {post.data.author.role ?? 'Newsdesk'}</span><span class="ml-auto px-2 py-1 border border-black/10 bg-white">{post.data.category}</span></div>
    <figure class="mt-6 border border-black/10"><img src={post.data.cover.src} alt={post.data.cover.alt} width="1200" height="630" loading="eager" class="w-full h-auto" /><figcaption class="px-3 py-2 mono text-[11px] bg-white border-t border-black/10 opacity-60">{post.data.cover.alt}</figcaption></figure>
    {post.data.excerpt && <div id="tldr" class="mt-6 bg-amber-50 border border-amber-200 p-4"><div class="mono text-[11px] font-[800] tracking-widest text-amber-700">TÓM TẮT 60 TỪ</div><p class="mt-2 mono text-[13px] leading-relaxed">{post.data.excerpt}</p></div>}
    <article class="prose max-w-none mt-8 prose-p:text-[#1a1a1a] prose-p:leading-[1.7] prose-headings:font-[800] prose-headings:tracking-[-0.02em]"><Content /></article>
    {post.data.sources && <section class="mt-8 bg-white border border-black/10 p-4"><div class="mono text-[11px] tracking-widest opacity-40">NGUỒN & KIỂM CHỨNG</div><ul class="mt-2 mono text-[12px] space-y-1">{post.data.sources.map(s => <li><a href={s.url} target="_blank" class="underline decoration-red-600 underline-offset-4 hover:text-red-600">{s.title}</a> <span class="opacity-40">— {s.publisher}</span></li>)}</ul></section>}
    {post.data.faq && <section class="mt-6 border border-black/10 p-4 bg-white"><div class="mono text-[11px] tracking-widest">FAQ</div><div class="mt-3 space-y-2">{post.data.faq.map(f => <details class="border border-black/10 p-3 bg-[#f8f5f0]"><summary class="mono text-[12px] font-[700] cursor-pointer">{f.question}</summary><p class="mt-2 mono text-[12px] leading-relaxed opacity-70">{f.answer}</p></details>)}</div></section>}
  </main>
</NewsLayout>
