---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news')).filter(p => !p.data.draft).sort((a,b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const breaking = posts.find(p => p.data.breaking) ?? posts[0];
const rest = posts.filter(p => p.id !== breaking?.id);
const latest = rest.slice(0, 10);
const more = rest.slice(10, 16);
---

<BaseLayout
  title="Tin nhanh 24h — n0ai Newsroom"
  description="Newsroom n0ai: tin nóng cập nhật 06:00/12:00/18:00/00:00, mỗi tin 900-1200 từ, nguồn kiểm chứng, breaking live."
  breadcrumbs={[{name:'Home', url:'https://news.n0ai.cloud/'}, {name:'News', url:'https://news.n0ai.cloud/news'}]}
>
  <Header />
  <!-- Breaking ticker -->
  {breaking && (
    <div class="bg-[var(--color-news)] text-white">
      <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 py-2 flex items-center gap-3 mono text-[12px]">
        <span class="px-2 py-1 bg-white text-[var(--color-news)] font-[800]">BREAKING</span>
        <a href={`/news/${breaking.id}`} class="truncate hover:underline font-[600]">{breaking.data.title}</a>
        <span class="ml-auto hidden sm:inline text-white/70">{breaking.data.publishDate.toLocaleDateString('vi-VN')}</span>
      </div>
    </div>
  )}

  <main class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex items-baseline gap-3 border-b border-[var(--color-border)] pb-4">
      <h1 class="display text-[36px] tracking-[-0.03em]">NEWSROOM</h1>
      <span class="mono text-[11px] tracking-widest text-[var(--color-text-faint)]">{posts.length} TIN — CẬP NHẬT LIÊN TỤC</span>
      <span class="ml-auto mono text-[11px] px-2 py-1 bg-[var(--color-news)] text-white hidden sm:inline">LIVE 24H</span>
    </div>

    {posts.length === 0 ? (
      <div class="py-16 text-center mono text-[13px] text-[var(--color-text-muted)] border border-dashed border-[var(--color-border)] mt-6">Chưa có tin — pipeline sẽ populate 4 lần/ngày.</div>
    ) : (
      <div class="grid lg:grid-cols-12 gap-6 mt-6">
        {/* Left: lead + list */}
        <div class="lg:col-span-8">
          {breaking && <NewsCard title={breaking.data.title} href={`/news/${breaking.id}`} image={breaking.data.cover.src} category={breaking.data.category} time={breaking.data.publishDate.toLocaleDateString('vi-VN')} excerpt={breaking.data.description} breaking={breaking.data.breaking} variant="lead" />}
          <div class="mt-2">
            {latest.map(p => (
              <NewsCard title={p.data.title} href={`/news/${p.id}`} image={p.data.cover.src} category={p.data.category} time={p.data.publishDate.toLocaleDateString('vi-VN')} excerpt={p.data.description} variant="row" />
            ))}
          </div>
        </div>
        {/* Right: dense sidebar */}
        <aside class="lg:col-span-4 space-y-6">
          <div class="bg-[var(--color-surface)] border border-[var(--color-border)] p-5">
            <div class="mono text-[11px] tracking-widest text-[var(--color-text-faint)]">THEO DÕI NHANH</div>
            <h3 class="mt-2 font-[700] tracking-[-0.02em]">15 bài/ngày — DeepSeek v4 Flash</h3>
            <p class="mt-2 text-[13px] leading-relaxed text-[var(--color-text-muted)]">Mỗi tin 900-1200 từ, có nguồn, FAQ, JSON-LD. Cập nhật 00/06/12/18h ICT.</p>
            <div class="mt-3 grid grid-cols-3 gap-2 mono text-center">
              <div class="bg-[var(--color-bg)] border border-[var(--color-border)] py-2"><div class="text-[18px] font-[800]">{posts.length}</div><div class="text-[10px] text-[var(--color-text-faint)]">TIN</div></div>
              <div class="bg-[var(--color-bg)] border border-[var(--color-border)] py-2"><div class="text-[18px] font-[800]">06:00</div><div class="text-[10px] text-[var(--color-text-faint)]">NEXT</div></div>
              <div class="bg-[var(--color-news)] text-white py-2"><div class="text-[18px] font-[800]">LIVE</div><div class="text-[10px]">24H</div></div>
            </div>
          </div>

          <div class="border border-[var(--color-border)]">
            <div class="px-4 py-3 mono text-[11px] tracking-widest bg-black text-white">TIN MỚI NHẤT</div>
            <div class="p-4">
              {more.length === 0 ? <div class="mono text-[12px] text-[var(--color-text-faint)]">Đang cập nhật...</div> : more.map(p => <a href={`/news/${p.id}`} class="block py-2 border-b border-[var(--color-border)]/50 last:border-0 hover:text-[var(--color-news)] transition"><div class="mono text-[11px] text-[var(--color-text-faint)]">{p.data.category} • {p.data.publishDate.toLocaleDateString('vi-VN')}</div><div class="text-[13px] font-[600] leading-[1.3] line-clamp-2">{p.data.title}</div></a>)}
            </div>
          </div>

          <div class="bg-[var(--color-bg-elevated)] border border-[var(--color-border)] p-4">
            <div class="mono text-[11px] tracking-widest">CHỦ ĐỀ HOT</div>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {['AI','Kinh tế','Công nghệ','Đời sống','Thế giới'].map(t => <a href={`/topics/${t.toLowerCase()}`} class="px-2.5 py-1 mono text-[11px] bg-[var(--color-surface)] border border-[var(--color-border)] hover:bg-white hover:text-black transition">#{t}</a>)}
            </div>
          </div>
        </aside>
      </div>
    )}
  </main>
  <Footer />
</BaseLayout>
