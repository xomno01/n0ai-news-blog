---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.filter(p => !p.data.draft).map(post => ({ params: { slug: post.id }, props: { post }}));
}
const { post } = Astro.props;
const { Content } = await render(post);
const site = 'https://news.n0ai.cloud';
const url = new URL(`/news/${post.id}`, site).toString();
const newsLd = {
  "@type": "NewsArticle",
  "@id": `${url}#article`,
  "headline": post.data.title,
  "description": post.data.description,
  "image": { "@type": "ImageObject", "url": post.data.cover.src, "caption": post.data.cover.alt },
  "datePublished": post.data.publishDate.toISOString(),
  "dateModified": (post.data.updateDate ?? post.data.publishDate).toISOString(),
  "author": { "@type": "Person", "name": post.data.author.name },
  "publisher": { "@id": `${site}/#org` },
  "articleSection": post.data.category,
  "inLanguage": "vi-VN",
  "isAccessibleForFree": true,
  "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["#tldr"] }
};
const faqLd = post.data.faq?.length ? { "@type": "FAQPage", "mainEntity": post.data.faq.map(f => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer }})) } : null;
const breadcrumbLd = { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": site }, { "@type": "ListItem", "position": 2, "name": "News", "item": `${site}/news` }, { "@type": "ListItem", "position": 3, "name": post.data.title, "item": url }] };
const jsonLd = [newsLd, breadcrumbLd, ...(faqLd?[faqLd]:[])];
---

<BaseLayout title={post.data.title} description={post.data.description} canonical={url} image={post.data.cover.src} imageAlt={post.data.cover.alt} type="article" publishDate={post.data.publishDate} updateDate={post.data.updateDate} author={post.data.author.name} jsonLd={jsonLd} breadcrumbs={[{name:'Home',url:site},{name:'News',url:`${site}/news`},{name:post.data.title,url}]}>
  <Header />
  <div class="border-b border-[var(--color-border)] bg-[var(--color-bg-elevated)]">
    <div class="mx-auto max-w-[760px] px-4 sm:px-6 py-3 flex items-center gap-2 mono text-[11px]">
      <span class="px-2 py-1 bg-[var(--color-news)] text-white font-[800]">{post.data.breaking ? 'BREAKING' : post.data.category.toUpperCase()}</span>
      <span class="text-[var(--color-text-faint)]">•</span>
      <time datetime={post.data.publishDate.toISOString()}>{post.data.publishDate.toLocaleDateString('vi-VN', { weekday:'long', day:'2-digit', month:'long', year:'numeric'})}</time>
      {post.data.location && <><span class="text-[var(--color-text-faint)]">•</span><span>{post.data.location}</span></>}
      <span class="ml-auto hidden sm:inline text-[var(--color-text-faint)]">{post.data.readingTime ?? 5}′ đọc</span>
    </div>
  </div>

  <main id="main" class="mx-auto max-w-[760px] px-4 sm:px-6 py-6">
    <h1 class="font-[800] tracking-[-0.03em] leading-[0.95] text-[32px] sm:text-[42px]">{post.data.title}</h1>
    <p class="mt-3 text-[17px] leading-relaxed text-[var(--color-text-muted)] border-l-2 border-[var(--color-news)] pl-4">{post.data.description}</p>
    
    <div class="mt-4 flex flex-wrap items-center gap-3 mono text-[12px] border-y border-[var(--color-border)] py-3">
      <span class="size-6 rounded-full bg-black text-white grid place-items-center text-[10px] font-[800]">{post.data.author.name[0]}</span>
      <span class="font-[700]">{post.data.author.name}</span>
      <span class="text-[var(--color-text-faint)]">— {post.data.author.role ?? 'Newsdesk'}</span>
      <span class="ml-auto mono text-[11px] px-2 py-1 bg-[var(--color-surface)] border border-[var(--color-border)]">{post.data.category}</span>
    </div>

    <figure class="mt-6 border border-[var(--color-border)] bg-[var(--color-surface)]">
      <img src={post.data.cover.src} alt={post.data.cover.alt} width={post.data.cover.width ?? 1200} height={post.data.cover.height ?? 630} loading="eager" fetchpriority="high" decoding="async" class="w-full h-auto" />
      <figcaption class="px-3 py-2 mono text-[11px] text-[var(--color-text-faint)] border-t border-[var(--color-border)]">{post.data.cover.alt}</figcaption>
    </figure>

    {post.data.excerpt && (
      <div id="tldr" class="mt-6 bg-amber-500/10 border border-amber-500/20 p-4">
        <div class="mono text-[11px] font-[800] tracking-widest text-amber-700">TÓM TẮT NHANH — 60 TỪ</div>
        <p class="mt-2 text-[14px] leading-relaxed">{post.data.excerpt}</p>
      </div>
    )}

    <article class="prose prose-news mt-8">
      <Content />
    </article>

    {post.data.sources && (
      <section class="mt-8 bg-[var(--color-surface)] border border-[var(--color-border)] p-4">
        <div class="mono text-[11px] tracking-widest text-[var(--color-text-faint)]">NGUỒN & KIỂM CHỨNG</div>
        <ul class="mt-2 space-y-1.5 mono text-[12px]">
          {post.data.sources.map(s => <li><a href={s.url} target="_blank" rel="noopener" class="underline decoration-[var(--color-news)] underline-offset-4 hover:text-[var(--color-news)]">{s.title}</a> <span class="text-[var(--color-text-faint)]">— {s.publisher}</span></li>)}
        </ul>
      </section>
    )}

    {post.data.faq && (
      <section class="mt-8 border border-[var(--color-border)] p-4">
        <div class="mono text-[11px] tracking-widest">HỎI NHANH</div>
        <div class="mt-3 space-y-3">
          {post.data.faq.map(f => <details class="border border-[var(--color-border)] bg-[var(--color-surface)] p-3"><summary class="mono text-[13px] font-[700] cursor-pointer">{f.question}</summary><p class="mt-2 mono text-[12px] leading-relaxed text-[var(--color-text-muted)]">{f.answer}</p></details>)}
        </div>
      </section>
    )}
  </main>
  <Footer />
</BaseLayout>
