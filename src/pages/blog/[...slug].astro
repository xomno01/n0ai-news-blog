---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.filter(p => !p.data.draft).map(post => ({ params: { slug: post.id }, props: { post }}));
}
const { post } = Astro.props;
const { Content } = await render(post);
const site = 'https://news.n0ai.cloud';
const url = new URL(`/blog/${post.id}`, site).toString();
const articleLd = {
  "@type": "BlogPosting",
  "@id": `${url}#article`,
  "headline": post.data.title,
  "description": post.data.description,
  "image": { "@type": "ImageObject", "url": post.data.cover.src, "caption": post.data.cover.alt },
  "datePublished": post.data.publishDate.toISOString(),
  "dateModified": (post.data.updateDate ?? post.data.publishDate).toISOString(),
  "author": { "@type": "Person", "name": post.data.author.name, "jobTitle": post.data.author.role ?? "Essayist" },
  "publisher": { "@id": `${site}/#org` },
  "articleSection": post.data.category,
  "keywords": post.data.tags.join(', '),
  "inLanguage": "vi-VN",
  "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["#tldr"] }
};
const faqLd = post.data.faq?.length ? { "@type": "FAQPage", "mainEntity": post.data.faq.map(f => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer }})) } : null;
const breadcrumbLd = { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": site }, { "@type": "ListItem", "position": 2, "name": "Atelier", "item": `${site}/blog` }, { "@type": "ListItem", "position": 3, "name": post.data.title, "item": url }] };
const jsonLd = [articleLd, breadcrumbLd, ...(faqLd?[faqLd]:[])];
---

<BaseLayout title={post.data.title} description={post.data.description} canonical={url} image={post.data.cover.src} imageAlt={post.data.cover.alt} type="article" publishDate={post.data.publishDate} updateDate={post.data.updateDate} author={post.data.author.name} jsonLd={jsonLd} breadcrumbs={[{name:'Home',url:site},{name:'Atelier',url:`${site}/blog`},{name:post.data.title,url}]}>
  <Header />
  <!-- Atelier masthead — serif, ink -->
  <div class="bg-[oklch(0.09_0.015_35)] border-b border-[var(--color-border)]">
    <div class="mx-auto max-w-[760px] px-4 sm:px-6 py-6">
      <div class="mono text-[11px] tracking-[0.14em] text-[var(--color-blog)]">ATELIER — ESSAY • {post.data.readingTime ?? 7}′ • {post.data.category.toUpperCase()}</div>
      <h1 class="display mt-3 text-[36px] sm:text-[48px] leading-[0.9] text-white">{post.data.title}</h1>
      <p class="mt-4 text-[17px] leading-relaxed text-[var(--color-text-muted)]">{post.data.description}</p>
      <div class="mt-5 flex items-center gap-3 mono text-[12px] border-t border-[var(--color-border)] pt-4">
        <div class="size-8 rounded-full bg-[var(--color-blog)] grid place-items-center text-white font-[800]">{post.data.author.name[0]}</div>
        <div><div class="font-[700] text-white">{post.data.author.name} — {post.data.author.role ?? 'Essayist'}</div><div class="text-[var(--color-text-faint)]">{post.data.publishDate.toLocaleDateString('vi-VN', { day:'2-digit', month:'long', year:'numeric'})} • {post.data.readingTime ?? 7} phút • {post.data.category}</div></div>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-[1100px] px-4 sm:px-6 lg:px-8 py-6 grid lg:grid-cols-[200px_1fr_200px] gap-8">
    <!-- TOC left — editorial -->
    <aside class="hidden lg:block sticky top-[88px] h-fit">
      <div class="mono text-[11px] tracking-widest text-[var(--color-text-faint)]">MỤC LỤC</div>
      <nav class="mt-3 space-y-1 mono text-[12px] leading-relaxed text-[var(--color-text-muted)]">
        <a href="#tldr" class="block hover:text-white">— TL;DR</a>
        <a href="#main" class="block hover:text-white">— Bài viết</a>
        <a href="#faq" class="block hover:text-white">— FAQ</a>
      </nav>
      <div class="mt-6 p-3 bg-[var(--color-surface)] border border-[var(--color-border)] mono text-[11px] leading-relaxed">
        <div class="font-[700] text-white">Atelier khác Newsroom</div>
        <div class="text-[var(--color-text-muted)]">Serif • Pullquote • Nhịp chậm • 1400 từ • Không đỏ breaking</div>
      </div>
    </aside>

    <main id="main" class="min-w-0">
      <figure class="overflow-hidden border border-[var(--color-border)]">
        <img src={post.data.cover.src} alt={post.data.cover.alt} width={post.data.cover.width ?? 1200} height={post.data.cover.height ?? 630} loading="eager" fetchpriority="high" class="w-full h-auto" />
        <figcaption class="px-3 py-2 mono text-[11px] text-[var(--color-text-faint)] bg-[var(--color-surface)] border-t border-[var(--color-border)]">{post.data.cover.alt}</figcaption>
      </figure>

      {post.data.excerpt && (
        <div id="tldr" class="mt-6 border-l-[3px] border-[var(--color-blog)] bg-[var(--color-surface)] p-5">
          <div class="blog-kicker text-[var(--color-blog)]">TL;DR — 60 từ</div>
          <p class="mt-2 font-[500] leading-relaxed text-[15px]">{post.data.excerpt}</p>
        </div>
      )}

      <!-- Pullquote — flamboyant -->
      <div class="my-8 border-y border-[var(--color-border)] py-6">
        <blockquote class="display text-[26px] leading-[1.1] text-center max-w-[560px] mx-auto">“{post.data.title.slice(0, 80)} — một lát cắt của tương lai đang diễn ra.”</blockquote>
        <div class="mt-2 mono text-[11px] tracking-widest text-center text-[var(--color-text-faint)]">— {post.data.author.name}, {post.data.category}</div>
      </div>

      <article class="prose prose-blog mt-6">
        <Content />
      </article>

      {post.data.sources && (
        <section class="mt-8 bg-[var(--color-surface)] border border-[var(--color-border)] p-4">
          <div class="mono text-[11px] tracking-widest">NGUỒN & THAM CHIẾU</div>
          <ul class="mt-2 space-y-1.5 mono text-[12px]">
            {post.data.sources.map(s => <li><a href={s.url} target="_blank" rel="noopener" class="underline decoration-[var(--color-blog)] underline-offset-4 hover:text-[var(--color-blog)]">{s.title}</a> <span class="text-[var(--color-text-faint)]">— {s.publisher}</span></li>)}
          </ul>
        </section>
      )}

      <section id="faq" class="mt-8 border border-[var(--color-border)] p-5">
        <div class="mono text-[11px] tracking-widest">FAQ — HỎI SÂU</div>
        <div class="mt-3 space-y-3">
          {post.data.faq?.map(f => <details class="bg-[var(--color-surface)] border border-[var(--color-border)] p-3"><summary class="font-[700] text-[14px] cursor-pointer">{f.question}</summary><p class="mt-2 text-[14px] leading-relaxed text-[var(--color-text-muted)]">{f.answer}</p></details>)}
        </div>
      </section>

      <div class="mt-6 flex flex-wrap gap-2">
        {post.data.tags.map(t => <span class="mono text-[11px] px-2.5 py-1 bg-[var(--color-surface)] border border-[var(--color-border)]">#{t}</span>)}
      </div>
    </main>

    <!-- Right rail — editorial -->
    <aside class="hidden lg:block sticky top-[88px] h-fit space-y-4">
      <div class="bg-[var(--color-blog)] text-white p-4">
        <div class="mono text-[11px] tracking-widest opacity-80">ĐỌC TRONG</div>
        <div class="mt-1 font-[800] text-[22px] leading-none">{post.data.readingTime ?? 7}′</div>
        <div class="mono text-[11px] opacity-80">1300—1600 từ • Serif</div>
      </div>
      <div class="border border-[var(--color-border)] p-4">
        <div class="mono text-[11px] tracking-widest">TÁC GIẢ</div>
        <div class="mt-2 flex gap-3">
          <div class="size-8 rounded-full bg-[var(--color-blog)] grid place-items-center text-white mono text-[11px]">{post.data.author.name[0]}</div>
          <div class="mono text-[12px]"><div class="font-[700]">{post.data.author.name}</div><div class="text-[var(--color-text-faint)]">{post.data.author.role}</div></div>
        </div>
      </div>
    </aside>
  </div>
  <Footer />
</BaseLayout>
