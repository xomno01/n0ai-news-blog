---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.filter(p => !p.data.draft).map(post => ({ params: { slug: post.id }, props: { post }}));
}
const { post } = Astro.props;
const { Content } = await render(post);
const site = 'https://news.n0ai.cloud';
const url = new URL(`/blog/${post.id}`, site).toString();
const articleLd = { "@type": "BlogPosting", "@id": `${url}#article`, "headline": post.data.title, "description": post.data.description, "image": { "@type": "ImageObject", "url": post.data.cover.src }, "datePublished": post.data.publishDate.toISOString(), "dateModified": (post.data.updateDate ?? post.data.publishDate).toISOString(), "author": { "@type": "Person", "name": post.data.author.name }, "publisher": { "@id": `${site}/#org` }, "articleSection": post.data.category };
const faqLd = post.data.faq?.length ? { "@type": "FAQPage", "mainEntity": post.data.faq.map(f => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer }})) } : null;
const breadcrumbLd = { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": site }, { "@type": "ListItem", "position": 2, "name": "Atelier", "item": `${site}/blog` }, { "@type": "ListItem", "position": 3, "name": post.data.title, "item": url }] };
const jsonLd = [articleLd, breadcrumbLd, ...(faqLd?[faqLd]:[])];
---
<BlogLayout title={post.data.title} description={post.data.description} canonical={url} image={post.data.cover.src} type="article" publishDate={post.data.publishDate} jsonLd={jsonLd}>
  <div class="bg-[oklch(0.09_0.015_35)] border-b border-[oklch(0.22_0.02_35)]">
    <div class="mx-auto max-w-[760px] px-4 sm:px-6 py-6">
      <div class="mono text-[11px] tracking-[0.14em] text-[oklch(0.58_0.16_270)]">ATELIER — ESSAY • {post.data.readingTime ?? 7}′ • {post.data.category.toUpperCase()}</div>
      <h1 class="display mt-3 text-[34px] sm:text-[44px] leading-[0.9] text-white">{post.data.title}</h1>
      <p class="mt-4 mono text-[14px] leading-relaxed text-white/60">{post.data.description}</p>
      <div class="mt-5 flex items-center gap-3 mono text-[12px] border-t border-white/10 pt-4">
        <div class="size-8 rounded-full bg-[oklch(0.58_0.16_270)] grid place-items-center text-white font-[800]">{post.data.author.name[0]}</div>
        <div><div class="font-[700] text-white">{post.data.author.name} — {post.data.author.role ?? 'Essayist'}</div><div class="text-white/40">{post.data.publishDate.toLocaleDateString('vi-VN')} • {post.data.readingTime ?? 7}′</div></div>
      </div>
    </div>
  </div>
  <div class="mx-auto max-w-[1100px] px-4 sm:px-6 lg:px-8 py-6 grid lg:grid-cols-[200px_1fr_200px] gap-8 bg-[oklch(0.09_0.015_35)] text-white">
    <aside class="hidden lg:block sticky top-[88px] h-fit mono text-[11px]">
      <div class="tracking-widest text-white/30">MỤC LỤC</div>
      <nav class="mt-3 space-y-1 text-white/60"><a href="#tldr" class="block hover:text-white">— TL;DR</a><a href="#main" class="block hover:text-white">— Bài viết</a><a href="#faq" class="block hover:text-white">— FAQ</a></nav>
      <div class="mt-6 p-3 bg-white/[0.04] border border-white/10"><div class="font-[700] text-white">Atelier ≠ Newsroom</div><div class="text-white/50 leading-relaxed">Serif Fraunces • Pullquote • 1400 từ</div></div>
    </aside>
    <main id="main" class="min-w-0">
      <figure class="overflow-hidden border border-white/10"><img src={post.data.cover.src} alt={post.data.cover.alt} width="1200" height="630" loading="eager" class="w-full h-auto" /><figcaption class="px-3 py-2 mono text-[11px] bg-white/[0.04] border-t border-white/10 text-white/40">{post.data.cover.alt}</figcaption></figure>
      {post.data.excerpt && <div id="tldr" class="mt-6 border-l-[3px] border-[oklch(0.58_0.16_270)] bg-white/[0.04] p-5"><div class="mono text-[11px] tracking-widest text-[oklch(0.58_0.16_270)]">TL;DR — 60 TỪ</div><p class="mt-2 mono text-[13px] leading-relaxed text-white/70">{post.data.excerpt}</p></div>}
      <div class="my-8 border-y border-white/10 py-6"><blockquote class="display text-[26px] leading-[1.1] text-center max-w-[560px] mx-auto text-white">“{post.data.title.slice(0, 80)} — một lát cắt của tương lai.”</blockquote><div class="mt-2 mono text-[11px] tracking-widest text-center text-white/30">— {post.data.author.name}</div></div>
      <article class="prose prose-invert max-w-none prose-p:text-white/80 prose-p:leading-[1.85] prose-p:text-[17px] prose-headings:font-[800] prose-headings:text-white"><Content /></article>
      {post.data.sources && <section class="mt-8 bg-white/[0.04] border border-white/10 p-4"><div class="mono text-[11px] tracking-widest text-white/30">NGUỒN</div><ul class="mt-2 mono text-[12px] space-y-1 text-white/60">{post.data.sources.map(s => <li><a href={s.url} target="_blank" class="underline decoration-[oklch(0.58_0.16_270)] underline-offset-4 hover:text-white">{s.title}</a> <span class="opacity-40">— {s.publisher}</span></li>)}</ul></section>}
      <section id="faq" class="mt-8 border border-white/10 p-5"><div class="mono text-[11px] tracking-widest text-white/30">FAQ — HỎI SÂU</div><div class="mt-3 space-y-3">{post.data.faq?.map(f => <details class="bg-white/[0.04] border border-white/10 p-3"><summary class="mono text-[13px] font-[700] cursor-pointer text-white">{f.question}</summary><p class="mt-2 mono text-[12px] leading-relaxed text-white/60">{f.answer}</p></details>)}</div></section>
    </main>
    <aside class="hidden lg:block sticky top-[88px] h-fit space-y-4 mono text-[11px]">
      <div class="bg-[oklch(0.58_0.16_270)] text-white p-4"><div class="tracking-widest opacity-80">ĐỌC TRONG</div><div class="font-[800] text-[22px] leading-none mt-1">{post.data.readingTime ?? 7}′</div><div class="opacity-80">1300—1600 từ</div></div>
      <div class="border border-white/10 p-4"><div class="tracking-widest text-white/30">TÁC GIẢ</div><div class="mt-2 flex gap-3"><div class="size-8 rounded-full bg-[oklch(0.58_0.16_270)] grid place-items-center text-white">{post.data.author.name[0]}</div><div><div class="font-[700] text-white">{post.data.author.name}</div><div class="text-white/40">{post.data.author.role}</div></div></div></div>
    </aside>
  </div>
</BlogLayout>
