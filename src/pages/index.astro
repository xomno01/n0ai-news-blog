---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BentoCard from '../components/BentoCard.astro';
import { getCollection } from 'astro:content';

const allNews = (await getCollection('news')).filter(p => !p.data.draft).sort((a,b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const allBlog = (await getCollection('blog')).filter(p => !p.data.draft).sort((a,b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const featuredNews = allNews.find(n => n.data.featured) ?? allNews[0];
const featuredBlog = allBlog.find(b => b.data.featured) ?? allBlog[0];
const secondaryNews = allNews.filter(n => n.id !== featuredNews?.id).slice(0,4);
const secondaryBlog = allBlog.filter(b => b.id !== featuredBlog?.id).slice(0,3);

// JSON-LD for homepage - ItemList
const site = 'https://news.n0ai.cloud';
const itemListLd = {
  "@type": "ItemList",
  "@id": `${site}/#top`,
  "name": "Top stories",
  "itemListElement": [featuredNews, ...secondaryNews].filter(Boolean).map((p, i) => ({
    "@type": "ListItem",
    "position": i+1,
    "url": `${site}/news/${p.id}`,
    "name": p.data.title
  }))
};
---

<BaseLayout
  title="n0ai — Tin nhanh & Blog AI hằng ngày"
  description="n0ai.cloud — Tin tức 24h, blog công nghệ & AI cập nhật tự động mỗi ngày. Mỗi bài viết chuẩn SEO·GEO·AEO·SDO, tốc độ 100/100, có nguồn kiểm chứng."
  image="/og-home.jpg"
  jsonLd={itemListLd}
>
  <Header />
  
  <!-- HERO - signature aurora moment -->
  <div class="relative overflow-hidden">
    <div class="aurora" aria-hidden="true">
      <div class="aurora-blob aurora-blob-1"></div>
      <div class="aurora-blob aurora-blob-2"></div>
      <div class="aurora-blob aurora-blob-3"></div>
    </div>
    
    <section class="relative mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 pt-10 pb-8">
      <div class="grid lg:grid-cols-12 gap-6 items-end">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white text-black text-[12px] font-[600] tracking-[-0.01em]">
            <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Cập nhật tự động hằng ngày — 06:00 & 18:00 ICT
            <span class="hidden sm:inline-flex ml-1 px-1.5 py-0.5 rounded-full bg-black text-white text-[10px] font-[700]">LIVE</span>
          </div>
          <h1 class="kinetic-title mt-5 text-[42px] sm:text-[56px] lg:text-[68px] tracking-[-0.04em]">
            Tin <span>nhanh.</span><br/>
            <span class="text-[var(--color-text-muted)]" style="-webkit-text-fill-color: var(--color-text-muted); background:none">Blog sâu.</span>
          </h1>
          <p class="mt-4 max-w-[560px] text-[16px] leading-relaxed text-[var(--color-text-muted)]">
            Tự động tổng hợp từ nguồn uy tín, viết lại hoàn chỉnh bởi AI + biên tập viên. Mỗi bài có <span class="text-white font-[500]">nguồn, FAQ, JSON-LD</span> và đạt <span class="text-white font-[500]">100/100 PageSpeed</span>.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/news" class="inline-flex items-center gap-2 px-5 h-11 rounded-full bg-white text-black font-[600] text-[14px] hover:bg-zinc-100 transition">Xem tin mới <span aria-hidden>→</span></a>
            <a href="/blog" class="inline-flex items-center gap-2 px-5 h-11 rounded-full bg-[var(--color-surface)] border border-[var(--color-border)] text-white font-[500] text-[14px] hover:bg-[var(--color-surface-hover)] transition">Đọc blog</a>
            <span class="inline-flex items-center gap-2 text-[12px] text-[var(--color-text-faint)]">
              <span class="size-1.5 rounded-full bg-[var(--color-primary)]"></span> Chuẩn SEO · SDO · GEO · AEO
            </span>
          </div>
        </div>
        <div class="lg:col-span-5">
          <div class="rounded-[20px] bg-[var(--color-surface)] border border-[var(--color-border)] p-4">
            <div class="flex items-center justify-between">
              <span class="text-[12px] font-[700] tracking-widest text-[var(--color-text-faint)]">TODAY</span>
              <span class="text-[12px] font-[500] text-[var(--color-text-muted)]">{new Date().toLocaleDateString('vi-VN', { weekday:'long', day:'2-digit', month:'long', year:'numeric'})}</span>
            </div>
            <div class="mt-3 grid grid-cols-3 gap-3 text-center">
              <div class="rounded-2xl bg-[var(--color-bg)] border border-[var(--color-border)] p-3">
                <div class="text-[22px] font-[800] tracking-[-0.02em]">{allNews.length}</div>
                <div class="text-[11px] font-[600] tracking-widest text-[var(--color-text-faint)]">TIN MỚI</div>
              </div>
              <div class="rounded-2xl bg-[var(--color-bg)] border border-[var(--color-border)] p-3">
                <div class="text-[22px] font-[800] tracking-[-0.02em]">{allBlog.length}</div>
                <div class="text-[11px] font-[600] tracking-widest text-[var(--color-text-faint)]">BLOG</div>
              </div>
              <div class="rounded-2xl bg-white text-black p-3">
                <div class="text-[22px] font-[800] tracking-[-0.02em]">100</div>
                <div class="text-[11px] font-[700] tracking-widest">SPEED</div>
              </div>
            </div>
            <p class="mt-3 text-[12px] leading-relaxed text-[var(--color-text-muted)]">Mỗi bài tự động sinh <code class="px-1 py-0.5 rounded bg-black/20 text-white font-[600]">JSON-LD</code> + FAQ + nguồn, tối ưu LCP & CLS = 0.</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <main id="main" class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 pb-12">
    <!-- BENTO - News -->
    <section class="mt-2">
      <div class="flex items-end justify-between gap-4 mb-4">
        <h2 class="text-[18px] font-[700] tracking-[-0.02em] flex items-center gap-2">
          <span class="size-2 rounded-full bg-red-500 animate-pulse"></span> Tin nhanh
          <span class="text-[12px] font-[600] tracking-widest text-[var(--color-text-faint)]">NEWS</span>
        </h2>
        <a href="/news" class="text-[13px] font-[600] text-[var(--color-text-muted)] hover:text-white transition">Xem tất cả →</a>
      </div>
      {featuredNews ? (
        <div class="bento">
          <BentoCard
            title={featuredNews.data.title}
            description={featuredNews.data.description}
            href={`/news/${featuredNews.id}`}
            image={featuredNews.data.cover.src}
            imageAlt={featuredNews.data.cover.alt}
            kicker={featuredNews.data.breaking ? 'BREAKING' : featuredNews.data.category}
            meta={`${featuredNews.data.category} • ${featuredNews.data.publishDate.toLocaleDateString('vi-VN')}`}
            size="large"
            featured
          />
          <div class="col-span-12 lg:col-span-4 grid gap-4">
            {secondaryNews.slice(0,2).map(post => (
              <BentoCard
                title={post.data.title}
                href={`/news/${post.id}`}
                image={post.data.cover.src}
                kicker={post.data.category}
                meta={post.data.publishDate.toLocaleDateString('vi-VN')}
                size="small"
              />
            ))}
          </div>
          <div class="col-span-12 grid md:grid-cols-2 lg:grid-cols-3 gap-4">
            {secondaryNews.slice(2,4).map(post => (
              <BentoCard
                title={post.data.title}
                description={post.data.description}
                href={`/news/${post.id}`}
                image={post.data.cover.src}
                kicker={post.data.category}
                size="medium"
              />
            ))}
          </div>
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-[var(--color-border)] p-12 text-center text-[var(--color-text-muted)]">
          Chưa có tin nào — pipeline sẽ tự động populate lúc 06:00 ICT hằng ngày.
        </div>
      )}
    </section>

    <!-- BENTO - Blog -->
    <section class="mt-10">
      <div class="flex items-end justify-between gap-4 mb-4">
        <h2 class="text-[18px] font-[700] tracking-[-0.02em] flex items-center gap-2">
          Blog
          <span class="text-[12px] font-[600] tracking-widest text-[var(--color-text-faint)]">DEEP DIVE</span>
        </h2>
        <a href="/blog" class="text-[13px] font-[600] text-[var(--color-text-muted)] hover:text-white transition">Tất cả bài →</a>
      </div>
      {featuredBlog ? (
        <div class="bento">
          <BentoCard
            title={featuredBlog.data.title}
            description={featuredBlog.data.description}
            href={`/blog/${featuredBlog.id}`}
            image={featuredBlog.data.cover.src}
            imageAlt={featuredBlog.data.cover.alt}
            kicker="FEATURED"
            meta={`${featuredBlog.data.category} • ${featuredBlog.data.readingTime ?? 5} phút`}
            size="large"
            featured
          />
          <div class="col-span-12 lg:col-span-4 grid gap-4">
            {secondaryBlog.map(post => (
              <BentoCard
                title={post.data.title}
                href={`/blog/${post.id}`}
                image={post.data.cover.src}
                kicker={post.data.category}
                meta={`${post.data.readingTime ?? 4} phút đọc`}
                size="small"
              />
            ))}
          </div>
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-[var(--color-border)] p-12 text-center text-[var(--color-text-muted)]">
          Chưa có bài blog — sẽ tự động tạo từ nguồn hằng ngày.
        </div>
      )}
    </section>

    <!-- Trust / E-E-A-T -->
    <section class="mt-12 rounded-[24px] bg-[var(--color-surface)] border border-[var(--color-border)] p-6 sm:p-8">
      <div class="grid lg:grid-cols-12 gap-6">
        <div class="lg:col-span-7">
          <h3 class="text-[16px] font-[700] tracking-[-0.02em]">Chuẩn mực xuất bản — E-E-A-T · GEO · AEO · SDO</h3>
          <ul class="mt-3 grid sm:grid-cols-2 gap-2 text-[13px] leading-relaxed text-[var(--color-text-muted)]">
            <li class="flex gap-2"><span class="text-emerald-400">✓</span> Mỗi bài có author, nguồn, ngày cập nhật, FAQ JSON-LD</li>
            <li class="flex gap-2"><span class="text-emerald-400">✓</span> Speakable + Q&A cho AI Overviews / Answer Engine</li>
            <li class="flex gap-2"><span class="text-emerald-400">✓</span> llms.txt + sitemap + robots chuẩn</li>
            <li class="flex gap-2"><span class="text-emerald-400">✓</span> Ảnh AVIF/WebP, width/height, lazy, LCP &lt;1.8s</li>
          </ul>
        </div>
        <div class="lg:col-span-5 rounded-2xl bg-[var(--color-bg)] border border-[var(--color-border)] p-4">
          <div class="text-[12px] font-[700] tracking-widest text-[var(--color-text-faint)]">PIPELINE TỰ ĐỘNG</div>
          <ol class="mt-2 space-y-1.5 text-[13px] text-[var(--color-text-muted)] list-decimal list-inside">
            <li>06:00 ICT — Fetch RSS (VNExpress, CafeBiz, NASA, OpenAI Blog...)</li>
            <li>AI rewrite qua thueapi.luuvan.site → bài hoàn chỉnh + FAQ + nguồn</li>
            <li>Generate markdown → commit → Cloudflare Pages build → 100/100</li>
          </ol>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
