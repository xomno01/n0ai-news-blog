---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsCard from '../components/NewsCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const allNews = (await getCollection('news')).filter(p => !p.data.draft).sort((a,b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const allBlog = (await getCollection('blog')).filter(p => !p.data.draft).sort((a,b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const leadNews = allNews[0];
const newsRows = allNews.slice(1, 7);
const leadBlog = allBlog[0];
const blogGrid = allBlog.slice(1, 4);

const site = 'https://news.n0ai.cloud';
const itemListLd = {
  "@type": "ItemList",
  "itemListElement": [leadNews, ...newsRows].filter(Boolean).map((p, i) => ({
    "@type": "ListItem",
    "position": i+1,
    "url": `${site}/news/${p.id}`,
    "name": p.data.title
  }))
};
---

<BaseLayout title="n0ai — Newsroom & Atelier" description="n0ai: Newsroom tin nóng 900-1200 từ + Atelier essay 1300-1600 từ. Hai kiến trúc riêng, cập nhật 4 lần/ngày, deepseek v4 flash, 15 bài/ngày." jsonLd={itemListLd}>
  <Header />
  <!-- Masthead -->
  <div class="border-b border-[var(--color-border)] bg-[var(--color-bg)]">
    <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 py-2 flex items-center gap-3 mono text-[11px] tracking-wide">
      <span class="hidden sm:inline text-[var(--color-text-faint)]">HANOI • {new Date().toLocaleDateString('vi-VN', { weekday:'long', day:'2-digit', month:'long', year:'numeric'})}</span>
      <span class="mx-auto sm:mx-0 mono text-[11px] px-2 py-1 bg-[var(--color-news)] text-white">NEWSROOM LIVE</span>
      <span class="hidden lg:inline text-[var(--color-text-faint)]">ATELIER ESSAY — SERIF • PULLQUOTE • TOC</span>
      <span class="ml-auto hidden md:inline-flex items-center gap-1.5 mono text-[11px] text-[var(--color-text-muted)]"><span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span> 15 BÀI/NGÀY</span>
    </div>
  </div>

  <main id="main" class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 py-6">
    <!-- Lead split: News vs Blog -->
    <div class="grid lg:grid-cols-12 gap-6">
      <section class="lg:col-span-7">
        <div class="flex items-baseline gap-2 border-b border-[var(--color-border)] pb-2">
          <h2 class="mono text-[12px] font-[800] tracking-[0.16em] text-[var(--color-news)]">NEWSROOM</h2>
          <span class="mono text-[11px] text-[var(--color-text-faint)]">TIN NÓNG — 900–1200 TỪ</span>
          <a href="/news" class="ml-auto mono text-[11px] hover:underline">Xem tất cả →</a>
        </div>
        {leadNews ? (
          <div class="mt-4">
            <NewsCard title={leadNews.data.title} href={`/news/${leadNews.id}`} image={leadNews.data.cover.src} category={leadNews.data.category} time={leadNews.data.publishDate.toLocaleDateString('vi-VN')} excerpt={leadNews.data.description} breaking={leadNews.data.breaking} variant="lead" />
            <div class="mt-2 divide-y divide-[var(--color-border)]">
              {newsRows.map(p => <NewsCard title={p.data.title} href={`/news/${p.id}`} image={p.data.cover.src} category={p.data.category} time={p.data.publishDate.toLocaleDateString('vi-VN')} excerpt={p.data.description} variant="row" />)}
            </div>
          </div>
        ) : <div class="mt-4 mono text-[12px] text-[var(--color-text-faint)] border border-dashed border-[var(--color-border)] p-8 text-center">Chưa có tin — sẽ lên 00/06/12/18h</div>}
      </section>

      <section class="lg:col-span-5">
        <div class="flex items-baseline gap-2 border-b border-[var(--color-border)] pb-2">
          <h2 class="mono text-[12px] font-[800] tracking-[0.16em] text-[var(--color-blog)]">ATELIER</h2>
          <span class="mono text-[11px] text-[var(--color-text-faint)]">ESSAY 1300–1600 TỪ</span>
          <a href="/blog" class="ml-auto mono text-[11px] hover:underline">Atelier →</a>
        </div>
        {leadBlog ? (
          <div class="mt-4">
            <BlogCard title={leadBlog.data.title} href={`/blog/${leadBlog.id}`} image={leadBlog.data.cover.src} category={leadBlog.data.category} excerpt={leadBlog.data.description} author={leadBlog.data.author.name} time={leadBlog.data.publishDate.toLocaleDateString('vi-VN')} readingTime={leadBlog.data.readingTime ?? 7} featured />
            <div class="mt-4 grid gap-4">
              {blogGrid.map(p => <BlogCard title={p.data.title} href={`/blog/${p.id}`} image={p.data.cover.src} category={p.data.category} excerpt={p.data.description} author={p.data.author.name} time={p.data.publishDate.toLocaleDateString('vi-VN')} readingTime={p.data.readingTime ?? 6} />)}
            </div>
          </div>
        ) : <div class="mt-4 mono text-[12px] text-[var(--color-text-faint)] border border-dashed border-[var(--color-border)] p-8 text-center">Chưa có essay — atelier sẽ lên cùng news</div>}

        <div class="mt-6 bg-[var(--color-surface)] border border-[var(--color-border)] p-4">
          <div class="mono text-[11px] tracking-widest">KHÁC BIỆT</div>
          <div class="mt-2 grid grid-cols-2 gap-3 mono text-[11px] leading-relaxed">
            <div class="bg-[var(--color-bg)] border border-[var(--color-border)] p-3"><div class="font-[800] text-[var(--color-news)]">NEWS</div><div class="text-[var(--color-text-muted)]">Đỏ • Mono • Dense • Breaking • 900 từ</div></div>
            <div class="bg-[var(--color-bg)] border border-[var(--color-border)] p-3"><div class="font-[800] text-[var(--color-blog)]">BLOG</div><div class="text-[var(--color-text-muted)]">Ink-blue • Serif • Pullquote • 1400 từ</div></div>
          </div>
        </div>
      </section>
    </div>

    <!-- Dense footer band — hết trống -->
    <div class="mt-8 grid lg:grid-cols-12 gap-6 border-t border-[var(--color-border)] pt-6">
      <div class="lg:col-span-8 mono text-[12px] leading-relaxed text-[var(--color-text-muted)]">
        <span class="font-[800] text-white">n0ai</span> — Newsroom & Atelier. Mỗi bài có author, nguồn, FAQ JSON-LD, speakable, llms.txt, sitemap. Ảnh 1200×630, LCP &lt;1.8s, CLS 0.
      </div>
      <div class="lg:col-span-4 mono text-[12px] text-[var(--color-text-faint)] text-right">Cập nhật 00:00 • 06:00 • 12:00 • 18:00 ICT — DeepSeek v4 Flash</div>
    </div>
  </main>
  <Footer />
</BaseLayout>
