---
import NewsLayout from '../layouts/NewsLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import { getCollection } from 'astro:content';
const allNews = (await getCollection('news')).filter(p => !p.data.draft).sort((a,b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const lead = allNews[0];
const grid = allNews.slice(1, 7);
const dense = allNews.slice(7, 30);
const cols1 = dense.slice(0, 8);
const cols2 = dense.slice(8, 16);
const cols3 = dense.slice(16, 23);
const site = 'https://news.n0ai.cloud';
const itemListLd = {
  "@type": "ItemList",
  "itemListElement": allNews.slice(0, 10).map((p, i) => ({ "@type": "ListItem", "position": i+1, "url": `${site}/news/${p.id}`, "name": p.data.title }))
};
---
<NewsLayout title="n0ai NEWS — 30 bài/ngày, báo giấy số" description="n0ai NEWS 100% news: 30 bài/ngày, 900-1200 từ, dense, breaking live, cập nhật 00/06/12/18h ICT, deepseek v4 flash." jsonLd={itemListLd}>
  {lead && (
    <div class="bg-red-600 text-white">
      <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 py-2 flex items-center gap-3 mono text-[12px]">
        <span class="px-2 py-1 bg-white text-red-600 font-[800]">BREAKING</span>
        <a href={`/news/${lead.id}`} class="truncate font-[700] hover:underline">{lead.data.title}</a>
        <span class="ml-auto hidden sm:inline opacity-80">{lead.data.publishDate.toLocaleDateString('vi-VN')}</span>
      </div>
    </div>
  )}
  <main class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex items-baseline gap-3 border-b-[3px] border-black pb-3">
      <h1 class="font-[900] tracking-[-0.04em] text-[28px] sm:text-[32px]" style="font-family: 'Instrument Serif', serif;">TRANG NHẤT — 100% NEWS</h1>
      <span class="mono text-[11px] tracking-widest bg-black text-white px-2 py-1">{allNews.length}/30 TIN</span>
      <span class="hidden sm:inline mono text-[11px] text-black/60">DENSE • KHÔNG BLOG • 900-1200 TỪ</span>
      <span class="ml-auto mono text-[11px] border border-black px-2 py-1 hidden md:inline">HANOI • {new Date().toLocaleDateString('vi-VN')}</span>
    </div>

    {allNews.length === 0 ? (
      <div class="py-16 text-center mono text-[13px] border border-dashed border-black/20 mt-6">Đang bơm 30 bài — 00/06/12/18h ICT</div>
    ) : (
      <>
        {lead && <div class="mt-6"><NewsCard title={lead.data.title} href={`/news/${lead.id}`} image={lead.data.cover.src} category={lead.data.category} time={lead.data.publishDate.toLocaleDateString('vi-VN')} excerpt={lead.data.description} breaking={lead.data.breaking} variant="lead" /></div>}

        <div class="mt-6 grid md:grid-cols-2 lg:grid-cols-3 gap-4">
          {grid.map(p => (
            <a href={`/news/${p.id}`} class="group block border border-black hover:bg-black hover:text-white transition">
              <div class="aspect-[16/10] overflow-hidden bg-zinc-100"><img src={p.data.cover.src} alt={p.data.title} width="400" height="250" loading="lazy" class="w-full h-full object-cover group-hover:scale-[1.02] transition duration-500" /></div>
              <div class="p-3">
                <div class="mono text-[10px] tracking-widest opacity-60">{p.data.category} • {p.data.publishDate.toLocaleDateString('vi-VN')}</div>
                <h3 class="mt-1 font-[700] leading-[1.2] text-[15px] line-clamp-2">{p.data.title}</h3>
                <p class="mt-1 mono text-[12px] leading-relaxed opacity-70 line-clamp-2">{p.data.description}</p>
              </div>
            </a>
          ))}
        </div>

        <div class="mt-8 grid lg:grid-cols-3 gap-6 border-t-[3px] border-black pt-6">
          <div>
            <div class="mono text-[11px] font-[800] tracking-[0.12em] border-b border-black pb-2">CỘT 1 — MỚI NHẤT</div>
            <div class="mt-2">
              {cols1.length === 0 ? <div class="mono text-[12px] opacity-60 py-4">Đang bơm...</div> : cols1.map(p => (
                <a href={`/news/${p.id}`} class="group flex gap-3 py-3 border-b border-black/10 hover:bg-black hover:text-white -mx-2 px-2 transition">
                  <div class="flex-1 min-w-0"><div class="mono text-[10px] opacity-60">{p.data.category} • {p.data.publishDate.toLocaleDateString('vi-VN')}</div><div class="font-[600] leading-[1.3] text-[13px] line-clamp-2 group-hover:underline">{p.data.title}</div></div>
                  <img src={p.data.cover.src} alt={p.data.title} width="80" height="60" loading="lazy" class="w-[72px] h-[54px] object-cover border border-black/10 shrink-0" />
                </a>
              ))}
            </div>
          </div>
          <div>
            <div class="mono text-[11px] font-[800] tracking-[0.12em] border-b border-black pb-2">CỘT 2 — KINH TẾ</div>
            <div class="mt-2">
              {cols2.length === 0 ? <div class="mono text-[12px] opacity-60 py-4">Đang bơm...</div> : cols2.map(p => (
                <a href={`/news/${p.id}`} class="group flex gap-3 py-3 border-b border-black/10 hover:bg-black hover:text-white -mx-2 px-2 transition">
                  <div class="flex-1 min-w-0"><div class="mono text-[10px] opacity-60">{p.data.category} • {p.data.publishDate.toLocaleDateString('vi-VN')}</div><div class="font-[600] leading-[1.3] text-[13px] line-clamp-2 group-hover:underline">{p.data.title}</div></div>
                  <img src={p.data.cover.src} alt={p.data.title} width="80" height="60" loading="lazy" class="w-[72px] h-[54px] object-cover border border-black/10 shrink-0" />
                </a>
              ))}
            </div>
          </div>
          <div>
            <div class="mono text-[11px] font-[800] tracking-[0.12em] border-b border-black pb-2">CỘT 3 — CÔNG NGHỆ</div>
            <div class="mt-2">
              {cols3.length === 0 ? <div class="mono text-[12px] opacity-60 py-4">Đang bơm...</div> : cols3.map(p => (
                <a href={`/news/${p.id}`} class="group flex gap-3 py-3 border-b border-black/10 hover:bg-black hover:text-white -mx-2 px-2 transition">
                  <div class="flex-1 min-w-0"><div class="mono text-[10px] opacity-60">{p.data.category} • {p.data.publishDate.toLocaleDateString('vi-VN')}</div><div class="font-[600] leading-[1.3] text-[13px] line-clamp-2 group-hover:underline">{p.data.title}</div></div>
                  <img src={p.data.cover.src} alt={p.data.title} width="80" height="60" loading="lazy" class="w-[72px] h-[54px] object-cover border border-black/10 shrink-0" />
                </a>
              ))}
            </div>
          </div>
        </div>

        <div class="mt-8 mono text-[11px] text-center py-3 border border-black bg-black text-white tracking-widest">30 BÀI — 100% NEWS — KHÔNG BLOG — DENSE — {allNews.length}/30</div>
      </>
    )}
  </main>
</NewsLayout>
