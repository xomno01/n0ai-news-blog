---
import "../styles/global.css";
import NewsHeader from "../components/NewsHeader.astro";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  jsonLd?: any;
}
const { title, description, canonical, image="/og-default.jpg", type='website', publishDate, jsonLd } = Astro.props;
const site = "https://news.n0ai.cloud";
const url = canonical ?? new URL(Astro.url.pathname, site).toString();
const pageTitle = title.includes('n0ai') ? title : `${title} — n0ai NEWS`;
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
  <meta property="og:site_name" content="n0ai NEWS" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={new URL(image, site).toString()} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#f8f5f0" />
  <link rel="icon" href="/favicon.svg" />
  {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
  <script type="application/ld+json" set:html={JSON.stringify({ "@context":"https://schema.org","@graph":[{ "@type":"Organization","@id":`${site}/#org`,"name":"n0ai NEWS","url":site },{ "@type":"WebSite","@id":`${site}/#website`,"name":"n0ai NEWS","url":site }, ...(jsonLd?[jsonLd]:[])] })} />
  <style>
    body { background: #f8f5f0; color: #0a0a0a; font-family: "Geist", system-ui, sans-serif; }
    .prose-news p { color: #1a1a1a; line-height: 1.7; }
  </style>
</head>
<body class="min-h-screen antialiased">
  <NewsHeader />
  <slot />
  <footer class="mt-12 bg-black text-white border-t-[4px] border-red-600">
    <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 py-8 grid md:grid-cols-12 gap-8 mono text-[12px]">
      <div class="md:col-span-5">
        <div class="font-[900] text-[20px] tracking-[-0.03em]" style="font-family: 'Instrument Serif', serif;">n0ai NEWSROOM</div>
        <div class="text-white/60 mt-2 leading-relaxed">Báo giấy số — 30 bài/ngày, 900-1200 từ, nguồn kiểm chứng, cập nhật 00/06/12/18h ICT. Không blog, 100% news.</div>
        <div class="mt-3 mono text-[11px] text-white/30">© 2026 n0ai.cloud • ISSN  -0001 • HANOI</div>
      </div>
      <div class="md:col-span-7 grid grid-cols-3 gap-6">
        <div><div class="font-[800] tracking-widest text-[11px]">CHUYÊN MỤC</div><div class="mt-2 space-y-1 text-white/70"><div>Thời sự</div><div>Kinh tế</div><div>Công nghệ</div><div>Đời sống</div></div></div>
        <div><div class="font-[800] tracking-widest text-[11px]">DỊCH VỤ</div><div class="mt-2 space-y-1 text-white/70"><div>RSS / Sitemap</div><div>llms.txt</div><div>Newsletter</div></div></div>
        <div><div class="font-[800] tracking-widest text-[11px]">LIÊN HỆ</div><div class="mt-2 text-white/70">hello@n0ai.cloud<br/>Hanoi, VN</div></div>
      </div>
    </div>
  </footer>
</body>
</html>
