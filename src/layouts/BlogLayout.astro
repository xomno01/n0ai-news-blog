---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  jsonLd?: any;
}
const { title, description, canonical, image="/og-default.jpg", type='website', publishDate, jsonLd } = Astro.props;
const site = "https://news.n0ai.cloud";
const url = canonical ?? new URL(Astro.url.pathname, site).toString();
const pageTitle = title.includes('n0ai') ? title : `${title} — n0ai Atelier`;
import BlogHeader from "../components/BlogHeader.astro";
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
  <meta property="og:site_name" content="n0ai Atelier" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={new URL(image, site).toString()} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0a0a0f" />
  <link rel="icon" href="/favicon.svg" />
  {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
  <script type="application/ld+json" set:html={JSON.stringify({ "@context":"https://schema.org","@graph":[{ "@type":"Organization","@id":`${site}/#org`,"name":"n0ai Atelier","url":site },{ "@type":"WebSite","@id":`${site}/#website`,"name":"n0ai Atelier","url":site }, ...(jsonLd?[jsonLd]:[])] })} />
  <style>
    body { background: oklch(0.09 0.015 35); color: oklch(0.97 0.005 35); font-family: "Geist", system-ui, sans-serif; }
    .display { font-family: "Fraunces", Georgia, serif; }
  </style>
</head>
<body class="min-h-screen antialiased selection:bg-[oklch(0.58_0.16_270/0.25)]">
  <BlogHeader />
  <slot />
  <footer class="mt-12 bg-[oklch(0.07_0.015_35)] border-t border-[oklch(0.22_0.02_35)] text-white">
    <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 py-8 grid md:grid-cols-12 gap-8">
      <div class="md:col-span-5">
        <div class="display text-[20px]">atelier</div>
        <div class="mono text-[12px] text-white/60 mt-2 leading-relaxed">Atelier essay — serif, pullquote, TOC, 1300-1600 từ. Khác hẳn Newsroom giấy.</div>
        <div class="mono text-[11px] text-white/40 mt-3">© 2026 n0ai.cloud • Atelier</div>
      </div>
      <div class="md:col-span-7 grid grid-cols-3 gap-6 mono text-[12px]">
        <div><div class="font-[800] tracking-widest text-[11px]">ATELIER</div><div class="mt-2 space-y-1 text-white/60"><div>Essay</div><div>Series</div></div></div>
        <div><div class="font-[800] tracking-widest text-[11px]">NEWS</div><div class="mt-2 text-white/60"><a href="/news" class="underline">→ Newsroom</a></div></div>
        <div><div class="font-[800] tracking-widest text-[11px]">RSS</div><div class="mt-2 text-white/60">/rss.xml</div></div>
      </div>
    </div>
  </footer>
</body>
</html>
