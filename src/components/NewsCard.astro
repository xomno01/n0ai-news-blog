---
interface Props {
  title: string;
  href: string;
  image?: string;
  category: string;
  time: string;
  excerpt?: string;
  breaking?: boolean;
  variant?: 'lead' | 'row' | 'compact';
}
const { title, href, image, category, time, excerpt, breaking, variant='row' } = Astro.props;
---

{variant === 'lead' ? (
  <a href={href} class="group grid lg:grid-cols-[1.15fr_0.85fr] gap-0 overflow-hidden bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-[var(--color-border-strong)] transition">
    <div class="relative aspect-[4/3] lg:aspect-[16/10] overflow-hidden bg-[var(--color-bg-elevated)]">
      {image && <img src={image} alt={title} width="800" height="500" loading="eager" class="w-full h-full object-cover group-hover:scale-[1.02] transition duration-700" />}
      <div class="absolute top-3 left-3 flex gap-2">
        {breaking ? <span class="px-2 py-1 bg-[var(--color-news)] text-white mono text-[11px] font-[800]">BREAKING</span> : <span class="px-2 py-1 bg-black text-white mono text-[11px]">{category}</span>}
        <span class="hidden sm:inline-flex px-2 py-1 bg-white text-black mono text-[11px]">{time}</span>
      </div>
    </div>
    <div class="p-6 lg:p-8 flex flex-col justify-center">
      <div class="mono text-[11px] tracking-widest text-[var(--color-text-faint)]">{category} — {time}</div>
      <h2 class="mt-2 font-[750] tracking-[-0.02em] leading-[1.05] text-[28px] lg:text-[34px] group-hover:text-[var(--color-news)] transition">{title}</h2>
      {excerpt && <p class="mt-3 text-[15px] leading-relaxed text-[var(--color-text-muted)] line-clamp-3">{excerpt}</p>}
      <div class="mt-4 mono text-[12px] text-[var(--color-text-faint)]">Đọc tiếp →</div>
    </div>
  </a>
) : variant === 'row' ? (
  <a href={href} class="group flex gap-4 py-5 border-b border-[var(--color-border)] hover:bg-[var(--color-surface)]/50 -mx-4 px-4 transition">
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 mono text-[11px]">
        <span class={breaking ? 'text-[var(--color-news)] font-[800]' : 'text-[var(--color-text-faint)]'}>{breaking ? 'BREAKING' : category}</span>
        <span class="size-1 rounded-full bg-[var(--color-border-strong)]"></span>
        <span class="text-[var(--color-text-faint)]">{time}</span>
      </div>
      <h3 class="mt-1.5 font-[650] tracking-[-0.015em] leading-[1.2] text-[17px] line-clamp-2 group-hover:text-[var(--color-news)] transition">{title}</h3>
      {excerpt && <p class="mt-1.5 text-[13px] leading-relaxed text-[var(--color-text-muted)] line-clamp-2">{excerpt}</p>}
    </div>
    {image && <img src={image} alt={title} width="160" height="106" loading="lazy" class="w-[112px] h-[84px] lg:w-[160px] lg:h-[106px] object-cover shrink-0 border border-[var(--color-border)]" />}
  </a>
) : (
  <a href={href} class="group block py-3 border-b border-[var(--color-border)]/60">
    <div class="mono text-[11px] text-[var(--color-text-faint)]">{category} • {time}</div>
    <h4 class="mt-1 font-[600] leading-[1.3] text-[14px] line-clamp-2 group-hover:text-[var(--color-news)] transition">{title}</h4>
  </a>
)}
