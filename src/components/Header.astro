---
const pathname = Astro.url.pathname;
const isNews = pathname.startsWith('/news');
const isBlog = pathname.startsWith('/blog');
---

<header class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[oklch(0.07_0.008_260/0.92)] backdrop-blur-xl">
  <!-- Ticker for news -->
  <div class="hidden lg:block border-b border-[var(--color-border)]/60 bg-black text-white">
    <div class="mx-auto max-w-[1280px] px-6 py-1.5 flex items-center gap-3 mono text-[11px]">
      <span class="px-1.5 py-0.5 bg-[var(--color-news)] text-white font-[800] tracking-widest">LIVE</span>
      <span class="text-white/70">06:00 ICT cập nhật • 15 bài/ngày • DeepSeek v4 Flash • Nguồn: VnExpress, Tuổi Trẻ, NYTimes</span>
      <span class="ml-auto text-white/50">n0ai.cloud — News & Blog</span>
    </div>
  </div>
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
    <div class="flex h-[62px] items-center gap-6">
      <a href="/" class="flex items-center gap-3">
        <div class="size-8 grid place-items-center bg-white text-black font-[900] tracking-tighter text-[14px]">n0</div>
        <div class="leading-none">
          <div class="font-[800] tracking-[-0.02em] text-[16px]">n0ai<span class="font-[400] text-[var(--color-text-muted)]">.cloud</span></div>
          <div class="mono text-[10px] tracking-[0.12em] text-[var(--color-text-faint)]">EST. 2024 — HANOI</div>
        </div>
      </a>
      <nav class="hidden md:flex items-center gap-1 ml-4">
        <a href="/news" class={`px-3.5 py-2 mono text-[12px] font-[700] tracking-wide border ${isNews ? 'bg-[var(--color-news)] text-white border-[var(--color-news)]' : 'border-transparent text-[var(--color-text-muted)] hover:text-white'}`}>NEWS</a>
        <a href="/blog" class={`px-3.5 py-2 mono text-[12px] font-[700] tracking-wide border ${isBlog ? 'bg-[var(--color-blog)] text-white border-[var(--color-blog)]' : 'border-transparent text-[var(--color-text-muted)] hover:text-white'}`}>BLOG</a>
        <a href="/topics" class="px-3 py-2 mono text-[12px] text-[var(--color-text-faint)] hover:text-white">CHỦ ĐỀ</a>
      </nav>
      <div class="ml-auto flex items-center gap-2">
        <span class="hidden sm:inline-flex mono text-[11px] px-2.5 py-1 bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-text-muted)]">100/100 SPEED</span>
        <a href="/rss.xml" class="hidden sm:inline-flex h-8 px-3 items-center bg-white text-black mono text-[11px] font-[700] hover:bg-zinc-100">RSS</a>
        <button id="m" class="md:hidden size-8 grid place-items-center border border-[var(--color-border)] bg-[var(--color-surface)]">≡</button>
      </div>
    </div>
    <div id="mm" class="hidden md:hidden pb-3">
      <nav class="grid gap-1 mono text-[13px]">
        <a href="/news" class="px-3 py-2 border border-[var(--color-border)] bg-[var(--color-surface)]">NEWS</a>
        <a href="/blog" class="px-3 py-2 border border-[var(--color-border)] bg-[var(--color-surface)]">BLOG</a>
      </nav>
    </div>
  </div>
</header>
<script>document.getElementById('m')?.addEventListener('click',()=>document.getElementById('mm')?.classList.toggle('hidden'))</script>
