---
---
<header class="sticky top-0 z-40 bg-[oklch(0.09_0.015_35)] border-b border-[oklch(0.22_0.02_35)] text-white">
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
    <div class="flex h-[64px] items-center gap-6">
      <a href="/blog" class="flex items-center gap-3">
        <div class="size-9 rounded-[12px] bg-[oklch(0.58_0.16_270)] grid place-items-center text-white font-[900] text-[14px]">a</div>
        <div class="leading-none">
          <div class="display text-[18px] tracking-[-0.02em]">atelier</div>
          <div class="mono text-[10px] tracking-[0.14em] text-white/50">N0AI • ESSAY 1300–1600</div>
        </div>
      </a>
      <nav class="hidden md:flex items-center gap-1 ml-6">
        <a href="/blog" class="px-4 py-2 mono text-[11px] font-[800] tracking-[0.1em] bg-white text-black">ATELIER</a>
        <a href="/blog#essay" class="px-3 py-2 mono text-[11px] text-white/60 hover:text-white">ESSAY</a>
        <a href="/blog#series" class="px-3 py-2 mono text-[11px] text-white/60 hover:text-white">SERIES</a>
        <a href="/news" class="ml-2 px-3 py-2 mono text-[11px] border border-white/15 text-white/70 hover:bg-white hover:text-black transition">NEWSROOM →</a>
      </nav>
      <div class="ml-auto hidden sm:flex items-center gap-2">
        <span class="mono text-[11px] px-2.5 py-1 bg-white/10 border border-white/15 text-white/70">SERIF • PULLQUOTE • TOC</span>
        <button id="bm" class="md:hidden size-8 grid place-items-center border border-white/15">≡</button>
      </div>
    </div>
    <div id="bmm" class="hidden md:hidden pb-3 grid gap-1 mono text-[12px]">
      <a href="/blog" class="px-3 py-2 bg-white text-black">ATELIER</a>
      <a href="/news" class="px-3 py-2 border border-white/15">NEWSROOM</a>
    </div>
  </div>
  <!-- Atelier subbar: flamboyant -->
  <div class="hidden lg:block bg-[oklch(0.58_0.16_270)] text-white">
    <div class="mx-auto max-w-[1280px] px-6 py-1.5 flex items-center gap-3 mono text-[11px]">
      <span class="font-[800] tracking-widest">ATELIER</span>
      <span class="opacity-70">Essay dài • Serif Fraunces • Pullquote • TOC • 1300–1600 từ • DeepSeek v4 Flash</span>
      <span class="ml-auto opacity-60">KHÁC HẲN NEWSROOM</span>
    </div>
  </div>
</header>
<script>document.getElementById('bm')?.addEventListener('click',()=>document.getElementById('bmm')?.classList.toggle('hidden'))</script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,800&family=Geist:wght@400;600&display=swap');
  .display { font-family: "Fraunces", Georgia, serif; font-weight: 800; letter-spacing: -0.02em; }
  .mono { font-family: "Geist Mono", monospace; }
</style>
